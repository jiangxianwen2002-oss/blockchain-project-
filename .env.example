# 复制为 .env 后填写，.env 不要提交到 GitHub
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
# 部署者 / 金库所有者（只用测试钱包！）
OWNER_PRIVATE_KEY=0x...
# AI 代理自己的钱包（与 owner 不同）
AGENT_PRIVATE_KEY=0x...
# AI 代理用（可选）
ANTHROPIC_API_KEY=

# 商家测试钱包（v2：拥有商家合约，负责发货 / 提现）
MERCHANT_ADDRESS=
MERCHANT_PRIVATE_KEY=

# 平台仲裁人（v3：裁决申诉）
PLATFORM_ADDRESS=
PLATFORM_PRIVATE_KEY=

# 模拟外部平台（CloudEats）的收款钱包
CLOUDEATS_ADDRESS=
CLOUDEATS_PRIVATE_KEY=

# 可选：用 OpenAI 协议（或 DeepSeek 等兼容接口）时的 Key 和地址，也可以直接在控制台 → AI 设置里填
OPENAI_API_KEY=
OPENAI_BASE_URL=
